  "configuration": {
    "tagName": "odh-activity-poi",
    "options": [
      {
        "key": "lat",
        "type": "text",
        "label": "Latitude of the center of the map",
        "required": true,
        "options": {
          "default": "46.4983"
        }
      },
      {
        "key": "lon",
        "type": "text",
        "label": "Longitude of the center of the map",
        "required": true,
        "options": {
          "default": "11.3548"
        }
      },
      {
        "key": "zoom",
        "type": "text",
        "label": "Zoom of the map",
        "required": true,
        "options": {
          "default": "10"
        }
      },
      {
        "key": "radius",
        "type": "text",
        "label": "Map search radius (m): Empty means unlimited (that is, no radius filter)",
        "required": false,
        "options": {
          "default": ""
        }
      },
      {
        "key": "language",
        "type": "select",
        "label": "Language",
        "required": false,
        "options": {
          "values": [
            "en",
            "de",
            "it"
          ],
          "default": "en"
        }
      },
      {
        "key": "showradius",
        "type": "select",
        "label": "Show search radius on map",
        "required": false,
        "options": {
          "values": [
            "false",
            "true"
          ],
          "default": "false"
        }
      },
      {
        "key": "categories",
        "type": "text",
        "label": "Main category Tag Ids to show in the picker (comma-separated). Defaults to the eight ODH main categories.",
        "required": false,
        "options": {
          "default": "wellness relaxation,eating drinking,summer,winter,culture attractions,traffic and transport,shops and service providers,other"
        }
      },
      {
        "key": "show-subcategories",
        "type": "select",
        "label": "Show Level 2/3 category menu entries (e.g. Health / Dentists). false = Level 1 only.",
        "required": false,
        "options": {
          "values": [
            "true",
            "false"
          ],
          "default": "true"
        }
      },
      {
        "key": "category-filter",
        "type": "multiselect",
        "label": "Optional whitelist of Tag Ids for menu entries (main, L2 or L3). Empty = all children of the configured main categories.",
        "required": false,
